# Dial
DIAL_API_KEY=
DIAL_FROM_NUMBER_ID=

# Public app URL, e.g. https://dial-hack.example.com
APP_URL=http://localhost:3000

# Local server
PORT=3000

# Shared unauthenticated prototype limits
MAX_CALLS_PER_HOUR=6
MAX_CALLS_PER_DAY=20

# Optional webhook signing secret if Dial webhooks are enabled
DIAL_WEBHOOK_SECRET=

