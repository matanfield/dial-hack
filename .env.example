# Dial
DIAL_API_KEY=
DIAL_FROM_NUMBER_ID=

# Public app URL, e.g. https://dial-hack.example.com
APP_URL=http://localhost:3000

# Local server
PORT=3000

# Shared unauthenticated prototype limits
MAX_CALLS_PER_HOUR=6
MAX_CALLS_PER_DAY=20

# Optional webhook signing secret if Dial webhooks are enabled
DIAL_WEBHOOK_SECRET=

# --- Step 2: availability surveys -------------------------------------------

# Google Places API (New) key — enables the find_businesses tool
GOOGLE_MAPS_API_KEY=

# Anthropic API key — enables server-side transcript extraction for surveys
# (without it, surveys return transcript excerpts and the chat model extracts)
ANTHROPIC_API_KEY=
# EXTRACT_MODEL=claude-opus-4-8

# Postgres connection string (e.g. Neon via Vercel Marketplace) — REQUIRED for
# surveys to work reliably on serverless; without it state is per-instance JSON
DATABASE_URL=

# Simultaneous calls per survey wave (server-clamped 1-5, default 3)
MAX_SURVEY_PARALLEL=3

# Operator dashboard (/dashboard) token, >= 16 chars — required in production
# (responses carry full numbers and transcripts); localhost works without it
DASHBOARD_TOKEN=
