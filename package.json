{
  "name": "dial-hack",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted MCP server that lets ChatGPT/Claude place outbound Dial voice calls on the user's behalf",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc",
    "smoke": "bash scripts/smoke.sh",
    "preview": "tsx scripts/preview-instruction.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
